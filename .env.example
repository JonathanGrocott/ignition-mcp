# Copy to .env and fill in values for local gateway smoke tests.

# Gateway base URL. The scripts append /data/<alias> unless MCP_BASE_URL is set.
IGNITION_HOST=http://localhost:8088
IGNITION_MCP_ALIAS=ignition-mcp

# Ignition API token. Either header style is accepted by the module.
IGNITION_API_TOKEN=replace_me

# Optional: override the full MCP base URL directly.
# MCP_BASE_URL=http://localhost:8088/data/ignition-mcp

# Optional: override test tag paths for your gateway.
# Defaults assume the sample tags provider plus a writable [default]MCP folder.
MCP_TEST_TAG_READ_PATH_1=[Sample_Tags]RampUDT/Ramp0
MCP_TEST_TAG_READ_PATH_2=[Sample_Tags]RampUDT/Ramp1
MCP_TEST_DEFINITION_READ_PATH=[Sample_Tags]
MCP_TEST_DEFINITION_WRITE_PATH=[default]MCP/NewFromMcp
MCP_TEST_BLOCKED_WRITE_PATH=[Sample_Tags]RampUDT/Ramp0
MCP_TEST_UDT_TYPE_PATH=[default]_types_/MCP/McpSmokeType
MCP_TEST_DELETE_PATH=[default]MCP/McpSmokeDeleteCandidate

# Set to false for a read-only first pass when tag write allowlists are not configured yet.
MCP_REQUIRE_TAG_WRITES=true

# Optional destructive-but-cleaned-up commit checks for project resources.
MCP_COMMIT_PROJECT_SCRIPT_TESTS=false
MCP_COMMIT_NAMED_QUERY_TESTS=false
